rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 🧾 인보이스 접수앱 (invoice-upload.html) — 2026-10-12 추가
    //
    // 왜 따로 두는가: 아래 기본 규칙이 contentType 을 'image/.*' 로 묶어 놔서
    // PDF·엑셀 인보이스가 storage/unauthorized 로 막혔다. 지점이 벤더에게
    // 메일로 받은 PDF 를 그대로 못 올리고 종이로 찍어야 했다.
    //
    // 이 자리(invoices/지점/파일)에서만 종류 제한을 푼다. 대신 **로그인한 사람만**
    // 쓰게 해서, 기본 규칙(로그인 없이도 이미지는 써짐)보다 오히려 더 좁다.
    // 25MB 는 실수로 영상을 올리는 것을 막으려는 선.
    match /invoices/{branch}/{file} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 26214400;
    }

    // ── 아래는 원래 있던 규칙 그대로 (건드리지 않음) ──
    // 채팅·업무지시 사진 7.3GB 가 이 규칙으로 돌아간다.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 15728640 && request.resource.contentType.matches('image/.*');
    }
  }
}
